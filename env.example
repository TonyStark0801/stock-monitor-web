# Backend API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1/api

# OAuth Redirect URLs
NEXT_PUBLIC_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/success
NEXT_PUBLIC_OAUTH_FAILURE_REDIRECT=http://localhost:3000/auth

# Finnhub API Configuration (Optional - for direct frontend calls)
# Note: In production, prefer using backend endpoints to keep API keys secure
# Get your API key from: https://finnhub.io/register
NEXT_PUBLIC_FINNHUB_API_KEY=your_finnhub_api_key_here

